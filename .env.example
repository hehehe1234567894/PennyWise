# ===== PennyWise 配置 =====
# 复制本文件为 .env 后填写（.env 不会提交到 git）

# 服务端口
PORT=8720

# 访问令牌（必填）：手机 PWA 首次打开时在"设置"里粘贴这个值。
# 建议改成你自己的随机字符串，例如随便敲一串字符。
AUTH_TOKEN=change-me-please

# Tailscale 域名（可选）：手机走 HTTPS 时的地址，例如 my-pc.my-tailnet.ts.net。
# 填了之后，手机端"连接检测"会把它列为候选端点；不填也能自动发现 Tailscale 的 100.x 地址。
TAILSCALE_NAME=

# ---- 文本解析模型（OpenAI 兼容接口）----
# 默认 DeepSeek：到 platform.deepseek.com 注册 → 创建 API Key → 粘贴到下面。
# 换成其他供应商只需改这三行（base_url 不要带末尾斜杠，如需 /v1 就写 /v1）。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 自动入账阈值：解析置信度达到即直接入账，无需确认（1 = 全部手动确认）
AUTO_CONFIRM=0.9

# ---- 视觉解析模型（截图识别，OpenAI 兼容接口）----
# 默认阿里云百炼：到 bailian.console.aliyun.com 注册获取。
# VISION_MODELS 是按序降级链：前面的模型失败（网络/报错/格式问题）自动换下一个。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3-vl-flash
VISION_MODELS=qwen3-vl-flash,qwen3.7-flash,qwen3.5-flash,qwen-vl-plus

# ---- 账单邮件自动导入（主方案，全自动兜底）----
# 每 12 小时检查邮箱一次，只读取白名单发件人的账单邮件（微信/支付宝/银行），其他邮件一律不碰、不上传云端。
# 支付宝：我的 → 账单 → 邮件账单（若支持每月自动发送则设置一次永久自动）；
# 微信：钱包 → 账单 → 下载账单 → 发送到邮箱（每月手动一次，月报会自动提醒）；
# 银行：网银开启"每月电子对账单发送到邮箱"（设置一次永久自动），把银行发件域名追加进 MAIL_FROM。
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启 IMAP/SMTP → 生成"客户端授权密码"作为 MAIL_PASS；
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP → 生成"授权码"作为 MAIL_PASS。
AUTO_IMPORT=0
# LLM 合并审核：账单行与已有记录疑似重复时，用 LLM 一次批量决策合并（0 = 关闭，只按单号去重）
BILL_LLM_MERGE=1
MAIL_IMAP_HOST=imap.163.com
MAIL_IMAP_PORT=993
MAIL_USER=
MAIL_PASS=
MAIL_BOX=INBOX
MAIL_FROM=微信支付|支付宝|alipay|wechatpay

# ---- 月报提醒（每月 1 日自动发送上月汇总）----
# 邮件通道（推荐）：163 邮箱 SMTP，用同一个授权码；微信里绑定"QQ邮箱提醒"仅适用于 QQ 邮箱。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
# 微信直推通道（可选）：到 sct.ftqq.com 用微信登录获取 SendKey 填入。
SERVERCHAN_KEY=
REPORT_DAY=1
REPORT_HOUR=9

# ---- 邮箱沟通 AI Agent（可选）----
# 只读"自己发的、主题为 PW"的邮件：正文交易文本 → 记账；附件截图 → 识别记账；
# 问账/闲聊 → AI 回答；"想买XX有平替吗" → 联网比价推荐。每 3 分钟检查一次，自动回信。
MAIL_CAPTURE=0
MAIL_PW_SUBJECT=PW
# 平替推荐用联网搜索模型（阿里云百炼，需 VISION_API_KEY）
RECOMMEND_MODEL=qwen-plus
